// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-database`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum LogLevel {
  fatal
  error
  warn
  info
  debug
  trace
  silent
}

model Session {
  id             Int          @id @default(autoincrement())
  session_name   String
  logs           Log[]
  agent_inputs   AgentInput[]
  max_turn       Int
  workspace_path String
  created_at     DateTime     @default(now())
}

model Log {
  id         Int      @id @default(autoincrement())
  session    Session  @relation(fields: [session_id], references: [id])
  session_id Int
  content    String
  log_level  LogLevel
  created_at DateTime
}

model AgentInput {
  id         Int      @id @default(autoincrement())
  session    Session  @relation(fields: [session_id], references: [id])
  session_id Int
  turn       Int
  input      Json
  created_at DateTime @default(now())
}
